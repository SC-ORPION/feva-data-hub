# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Signs voter sessions and hashes codes. Any long random string: `openssl rand -base64 48`
VOTER_SESSION_SECRET=

# Optional: the product name shown everywhere
NEXT_PUBLIC_APP_NAME=FEVA Vote

# Optional: give each organization its own subdomain, e.g. achimota.fevavote.com.
# Needs a wildcard domain (*.fevavote.com) pointed at your host. Leave empty to use /v/<org> links.
NEXT_PUBLIC_ROOT_DOMAIN=

# Email for voter sign-in codes, receipts and results. Any SMTP service works:
# Gmail (app password), Zoho, Brevo, Resend, Mailgun…
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=FEVA Vote <vote@yourdomain.com>

# Text messages for voters who sign in with a phone number (arkesel.com, Ghana)
ARKESEL_API_KEY=
SMS_SENDER_ID=FEVAVote

# Shows sign-in codes on screen when email/SMS isn't set up. For trying things out only:
# never turn this on for a real election.
OTP_TEST_MODE=false

# Time zone for dates in emails
DISPLAY_TIMEZONE=Africa/Accra
